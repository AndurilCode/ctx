{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pretool-check-loc.mjs",
            "cwd": ".",
            "statusMessage": "Checking projected line count…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pretool-diff.mjs",
            "cwd": ".",
            "statusMessage": "Rewriting diff commands through ctx…"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pretool-prune-log.mjs",
            "cwd": ".",
            "statusMessage": "Rewriting noisy commands through ctx prune…"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/mcp-to-toon.mjs",
            "cwd": ".",
            "statusMessage": "Converting MCP output to TOON…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/mcp-to-toon.mjs",
            "cwd": ".",
            "statusMessage": "Converting JSON output to TOON…"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Injecting context rules…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/context-inject.mjs",
            "cwd": ".",
            "statusMessage": "Resetting harness state before compaction…"
          }
        ]
      }
    ]
  }
}
